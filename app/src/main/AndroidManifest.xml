<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET"/>
    <queries>
        <intent><action android:name="android.speech.action.RECOGNIZE_SPEECH"/></intent>
    </queries>
    <application android:usesCleartextTraffic="false" android:supportsRtl="true" android:icon="@drawable/ic_keypop_logo" android:roundIcon="@drawable/ic_keypop_logo" android:allowBackup="false" android:label="KeyPop" android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity android:name=".KeyPopVoiceActivity" android:exported="false"/>
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <service android:name=".AetherImeService" android:permission="android.permission.BIND_INPUT_METHOD" android:exported="true" android:label="KeyPop Keyboard">
            <intent-filter><action android:name="android.view.InputMethod"/></intent-filter>
            <meta-data android:name="android.view.im" android:resource="@xml/method"/>
        </service>
    </application>
</manifest>
